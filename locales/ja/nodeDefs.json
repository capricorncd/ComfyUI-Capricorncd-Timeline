  "CAP_H3VideoGenerator": {
    "display_name": "MiniMax H3 動画生成",
    "outputs": {
      "composed_video": {
        "name": "結合動画"
      }
    },
    "inputs": {
      "interpolation_config": {
        "name": "フレーム補間設定"
      },
      "face_refine_config": {
        "name": "H3 顔修復設定"
      },
      "motion_deblur": {
        "name": "モーションブラー低減（実験）",
        "tooltip": "初期値はオフ。MatlowAI の MAINodes による追加修復。MAINodes と高速化 LoRA を含まないベースモデルが必要です。時間・メモリが増え、動作の細部が変化する場合があります。元のフレーム数、音声、Context 冒頭と厳密モードの両端を保持します。"
      },
      "first_pass_megapixels": {
        "name": "一次サンプリングのメガピクセル",
        "tooltip": "二次サンプリング時のみ有効。一次の低解像度を指定し、最終サイズは data_json に従います。二次がオフの場合は無視し、data_json の幅・高さで直接生成します。"
      },
      "model": {
        "name": "サンプリングモデル（LoRA 適用済み）",
        "tooltip": "外部で LoRA を適用したモデルを接続。動画の一次・二次サンプリングとプレビューに使用。内部で LoRA は読み込みません。"
      },
      "base_model": {
        "name": "ベースモデル（任意）",
        "tooltip": "接続時は音声修復と基本スケジュールに使用。未接続ならサンプリングモデルを使用します。モーションブラー低減時は、高速化 LoRA を含まないベースモデルの接続が必須です。"
      },
      "audio_refine": {
        "name": "音声を修復",
        "tooltip": "追加の音声修復を実行します。動画音声の生成がオフの場合は自動でスキップします。"
      },
      "generate_audio": {
        "name": "動画音声を生成",
        "tooltip": "オフ：音声修復・デコード・音量正規化・音声出力を省略し、無音動画を保存。H3 の音声 latent の共同サンプリングと音声参照は維持します。"
      },
      "compose_final": {
        "name": "最終動画を結合",
        "tooltip": "全 Clip の完了後、data_json の Context 置換とトリミング規則で原音付き動画を結合。字幕・メディアトラックの描画は含みません。"
      },
      "sampling_preview": {
        "name": "サンプリングプレビュー",
        "tooltip": "各 Clip のサンプリング動画を表示し、完了後に生成動画へ切り替えます。フレーム数は自動取得。KJNodes が必要ですが、外部プレビューノードは不要です。"
      },
      "preview_tiny_vae": {
        "name": "プレビュー Tiny VAE",
        "tooltip": "models/vae_approx の taeh3.safetensors を選択できます。none は近似色で表示。完成動画は完全な VAE でデコードします。"
      },
      "strict_keyframes": {
        "name": "開始・終了フレームを固定",
        "tooltip": "オフ：複数画像・動画・音声の参照生成。オン：画像1枚を開始、2枚を開始・終了フレームの条件として使用。画素の完全一致は保証しません。動画・音声参照や Motion Context との併用不可。対応する FL モデルと LoRA を選択してください。"
      },
      "sampling_mode": {
        "name": "サンプリングモード"
